generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  active
  trialing
  canceled
  inactive
}

model Subscription {
  email                String               @id
  status               SubscriptionStatus   @default(inactive)
  stripeCustomerId     String?              @unique @map("stripe_customer_id")
  stripeSubscriptionId String?              @unique @map("stripe_subscription_id")
  clientReferenceId    String?              @map("client_reference_id")
  /** Sticky — set on first checkout, never cleared when the subscription is canceled. */
  trialUsed            Boolean              @default(false) @map("trial_used")
  selectedCity         String               @default("london") @map("selected_city")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([clientReferenceId])
  @@index([status])
  @@index([selectedCity])
  @@map("subscriptions")
}

model UserPreference {
  clerkUserId           String   @id @map("clerk_user_id")
  selectedCity          String   @default("london") @map("selected_city")
  /** False until the user picks a city on /welcome (session claim must not count). */
  cityChosen            Boolean  @default(false) @map("city_chosen")
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  currentSessionToken   String?  @map("current_session_token")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([selectedCity])
  @@index([notificationsEnabled])
  @@map("user_preferences")
}

model SmsSubscriber {
  phone            String   @id
  active           Boolean  @default(true)
  selectedCity     String   @default("london") @map("zone_id")
  /** Owning Clerk account — required for prefs / opt-out after opt-in. */
  clerkUserId      String?  @map("clerk_user_id")
  /** Mirror Live Desk / Progressier category toggles for SMS fan-out. */
  alertAccidents   Boolean  @default(true) @map("alert_accidents")
  alertIncidents   Boolean  @default(false) @map("alert_incidents")
  alertPolice      Boolean  @default(false) @map("alert_police")
  alertFire        Boolean  @default(true) @map("alert_fire")
  alertWaze        Boolean  @default(true) @map("alert_waze")
  alertGoogleMaps  Boolean  @default(true) @map("alert_google_maps")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([selectedCity])
  @@index([clerkUserId])
  @@map("sms_subscribers")
}
