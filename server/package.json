{
  "name": "@tow-not/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && npm run build --prefix ../client && tsc -p tsconfig.json && node ../scripts/copy-client-dist.cjs",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-json": "tsx src/scripts/migrateJsonToDb.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@deepgram/sdk": "^5.8.0",
    "@prisma/client": "^6.19.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "bullmq": "^6.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0",
    "typescript": "^5.8.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.3"
  }
}
