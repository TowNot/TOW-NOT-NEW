PORT=8080
CLIENT_ORIGIN=http://localhost:5173
# Push deep-links — plain https URL only (no markdown wrappers)
PUBLIC_URL=https://alertnav.com
PROGRESSIER_API_KEY=
# Dashboard > API Docs > Send notifications programmatically (per-app endpoint)
PROGRESSIER_PUSH_URL=
PROGRESSIER_APP_ID=Bv9Rb1Vm5PkATyh6w0wG
RAPIDAPI_KEY=
APIFY_API_TOKEN=
DEEPGRAM_API_KEY=
# BullMQ notification queue (Redis). Defaults to 127.0.0.1:6379 when unset.
REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# PostgreSQL — Stripe subscriptions + SMS opt-ins (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/alertnav
# London-only ingest lock (default on). Set to 0 only when enabling multi-city.
LONDON_ONLY_INGEST=1
# Toronto Fire CAD vehicle poller (also blocked while London-only is on).
TORONTO_FIRE_CAD_ENABLED=
RADIO_HLS_URL=
RESIDENTIAL_PROXY_URL=
WAZEAPI_KEY=
# Downtown London, ON. BlocksInside box: 42.8949,-81.3683 .. 43.0749,-81.1223
LONDON_LAT=42.9849
LONDON_LNG=-81.2453
POLL_INTERVAL_MS=10000
# Soft expiresAt TTL on ingest (ms). Desk UI also hides anything older than 3h by timestamp.
INCIDENT_TTL_MS=10800000
# Hard-delete from in-memory store when first-seen timestamp is older than this (default 24h)
INCIDENT_HARD_DELETE_MS=86400000
INCIDENT_HARD_DELETE_INTERVAL_MS=3600000
WAZE_BOTTOM_LEFT=42.8949, -81.3683
WAZE_TOP_RIGHT=43.0749, -81.1223
WAZEAPI_COUNTRY=eur
# OpenWebNinja Google Maps traffic alerts (separate 30s poller, zooms 11–16)
OPENWEBNINJA_API_KEY=
GOOGLE_MAPS_POLL_INTERVAL_MS=30000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12494025882
# Stripe — Payment Link + webhook (server needs secret + webhook secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_URL=https://buy.stripe.com/5kQbJ0eL3ahB6ax6dc8Vi00
# Client (Vite): set in client/.env or Railway build env
# VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/5kQbJ0eL3ahB6ax6dc8Vi00
# Clerk — set BOTH of these on Railway (Variables tab for @tow-not/server):
#
#   CLERK_PUBLISHABLE_KEY = pk_live_...   (or pk_test_...)
#   CLERK_SECRET_KEY      = sk_live_...   (or sk_test_...)
#
# Use these exact names. The publishable key is the pk_ one from
# https://dashboard.clerk.com → API Keys.
# Optional: keep VITE_CLERK_PUBLISHABLE_KEY as a duplicate of the same pk_ value
# for local Vite builds; production prefers CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# Google Maps Static API — incident card thumbnails (server injects into the client).
# Set any one of these on Railway; Vite does not auto-expose NEXT_PUBLIC_* like Next.js.
GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
